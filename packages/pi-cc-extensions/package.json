{
	"name": "@herbertgao/pi-cc-extensions",
	"version": "0.11.1",
	"license": "MIT",
	"description": "A Pi productivity suite with Claude Code-style UI, context inspection, and agent/session references",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"claude-code"
	],
	"homepage": "https://github.com/HerbertGao/pi-extensions/tree/master/packages/pi-cc-extensions#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HerbertGao/pi-extensions.git",
		"directory": "packages/pi-cc-extensions"
	},
	"bugs": {
		"url": "https://github.com/HerbertGao/pi-extensions/issues"
	},
	"author": "Herbert Gao",
	"files": [
		"extensions",
		"assets/readme",
		"themes",
		"README.md",
		"README.en.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		],
		"themes": [
			"./themes/cc-dark.json",
			"./themes/cc-light.json"
		],
		"image": "https://raw.githubusercontent.com/HerbertGao/pi-extensions/master/packages/pi-cc-extensions/assets/readme/preview.webp",
		"video": "https://github.com/minuque/pi-cc-extensions/releases/download/v0.9.4/demo.mp4"
	},
	"scripts": {
		"test": "node scripts/test.mjs",
		"coverage": "node scripts/test.mjs --experimental-test-coverage --test-coverage-include=extensions/**/*.ts",
		"docs:tool-render": "node --experimental-strip-types scripts/generate-tool-render-examples.ts",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format ."
	},
	"dependencies": {
		"@shikijs/cli": "^4.0.2",
		"grok-mermaid": "^0.2.2",
		"jiti": "^2.7.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^26.1.1",
		"typescript": "^5.9.3"
	},
	"x-upstream": {
		"package": "pi-cc-extensions",
		"version": "0.9.10",
		"reviewedVersion": "0.9.12",
		"repository": "https://github.com/minuque/pi-cc-extensions",
		"commit": "2b72669cafefe0771b2e3e63b0db5c478314d2d4"
	}
}
