  "description": "Search the Agency Agents catalog and dispatch its personas to Pi subagents without loading them into context.",
  "keywords": [
    "agency-agents",
    "pi-extension",
    "pi-package",
    "subagents"
  ],
  "homepage": "https://github.com/HerbertGao/pi-extensions/tree/master/packages/pi-agency#readme",
  "bugs": {
    "url": "https://github.com/HerbertGao/pi-extensions/issues"
  },
  "license": "MIT",
  "author": "Herbert Gao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HerbertGao/pi-extensions.git",
    "directory": "packages/pi-agency"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
