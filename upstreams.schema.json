{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["repositories", "companions", "pypi"],
  "properties": {
    "$schema": { "type": "string" },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repository", "reviewedCommit", "watch"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+$"
          },
          "reviewedCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "watch": { "enum": ["npm", "commits"] }
        }
      }
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "repository"],
        "properties": {
          "package": { "type": "string", "minLength": 1 },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+$"
          }
        }
      }
    },
    "pypi": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "repository", "pin", "watch"],
        "properties": {
          "package": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+$"
          },
          "pin": {
            "type": "string",
            "pattern": "^pins/[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "watch": { "enum": ["pypi"] }
        }
      }
    }
  }
}
